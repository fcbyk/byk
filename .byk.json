{
  "$priority": -1,
  "mac":{
    "创建软链接": "ln -sf \"$(pwd)/target/debug/byk\" /opt/homebrew/bin/byk",
    "移除软链接": "rm -f /opt/homebrew/bin/byk",
    "查看软链接": "ls -la /opt/homebrew/bin/byk && echo '---' && echo \"$PATH\" | tr ':' '\\n' | nl"
  },

  "win": {
    "$description": "创建软链接，需要管理员权限",
    "创建目录": "cmd /c if not exist %USERPROFILE%\\.byk\\bin mkdir %USERPROFILE%\\.byk\\bin",
    "创建软链接": "cmd /c scripts\\symlink-win.cmd",
    "移除软链接": "cmd /c if exist %USERPROFILE%\\.byk\\bin\\byk.exe del %USERPROFILE%\\.byk\\bin\\byk.exe",
    "查看软链接": "cmd /c dir /AL %USERPROFILE%\\.byk\\bin"
  },

  "dev": {
    "运行": "cargo run",
    "构建": "cargo build --release",
    "清空缓存": "hash -r",
    "test": "cargo test",
    "lint": "cargo clippy",
    "cov": "cargo llvm-cov"
  },

  "git": {
    "查看本地标签": "git tag",
    "查看远程库标签": "git ls-remote --tags origin",
    "推送标签到远程库": "git push origin --tags",
    "撤销上一次提交": "git reset --soft HEAD~1"
  },

  "发布": {
    "生成变更日志": "cz changelog --incremental",
    "更新版本号": {
      "$interactive": true,
      "$cmd": "cz bump {version}"
    },
    "maturin": {
      "打包arm": "maturin build --release --out dist",
      "打包x86": "maturin build --release --out dist --target x86_64-apple-darwin",
      "源码包": "maturin sdist --out dist"
    },
    "检查上传的文件": "twine check dist/*",
    "上传到PyPI": "twine upload dist/*",
    "推送标签到远程库": "git push origin --tags"
  }
}
